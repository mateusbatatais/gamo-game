; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Cartridge Crusade"
config/description="Bullet heaven roguelite — promo game for Gamo platform"
config/version="0.1.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
FontSetup="*res://scripts/autoload/font_setup.gd"
GameState="*res://scripts/autoload/game_state.gd"
ArenaBounds="*res://scripts/autoload/arena_bounds.gd"
Sprites="*res://scripts/autoload/sprites.gd"
CartridgeRegistry="*res://scripts/autoload/cartridge_registry.gd"
XpSystem="*res://scripts/autoload/xp_system.gd"
PlayerTrail="*res://scripts/autoload/player_trail.gd"
SpiritRegistry="*res://scripts/autoload/spirit_registry.gd"
EraRegistry="*res://scripts/autoload/era_registry.gd"
I18n="*res://scripts/autoload/i18n.gd"
Settings="*res://scripts/autoload/settings.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"
SceneTransition="*res://scripts/autoload/scene_transition.gd"
Audio="*res://scripts/autoload/audio.gd"
Music="*res://scripts/autoload/music.gd"
HitStop="*res://scripts/autoload/hit_stop.gd"
CrtOverlay="*res://scripts/autoload/crt_overlay.gd"
UpgradeRegistry="*res://scripts/autoload/upgrade_registry.gd"
AchievementRegistry="*res://scripts/autoload/achievement_registry.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

